# dependencies
node_modules/

# build output & generated types
dist/
.astro/

# package manager (repo standardizes on npm; ignore local pnpm artifacts)
pnpm-lock.yaml
pnpm-workspace.yaml

# logs
*.log

# environment variables
.env
.env.*
!.env.example

# editors
.vscode/
.idea/
*.swp

# OS noise
.DS_Store
Thumbs.db

# AI assistant local state
.claude/
AGENTS.md
MEMORY.md

# inbox pipeline runtime (track only the placeholder + docs)
inbox/*
!inbox/.gitkeep
!inbox/README.md

# Obsidian: shared config, not machine state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/hotkeys.json
.obsidian/themes/
.obsidian/snippets/
